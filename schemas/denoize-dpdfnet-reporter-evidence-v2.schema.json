{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-dpdfnet-reporter-evidence-v2.schema.json",
  "title": "denoize DPDFNet issue-reporter human evidence v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "schema_version", "github", "payload", "runs", "checks", "accepted"],
  "properties": {
    "schema": { "const": "denoize-dpdfnet-reporter-evidence-v2" },
    "schema_version": { "const": 2 },
    "github": { "$ref": "#/$defs/github" },
    "payload": { "$ref": "#/$defs/payload" },
    "runs": {
      "type": "array",
      "minItems": 3,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/normalizedRun" }
    },
    "checks": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/check" }
    },
    "accepted": { "type": "boolean" }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "bounded": { "type": "string", "minLength": 1, "maxLength": 256 },
    "audibleXruns": {
      "description": "Exact observed audible XRUN count, or null when audible discontinuities were observed but not counted exactly.",
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "null" }
      ]
    },
    "github": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "issue", "comment_id", "comment_url", "author", "created_at", "updated_at", "comment_body_sha256"],
      "properties": {
        "repository": { "const": "penguin425/denoize" },
        "issue": { "const": 221 },
        "comment_id": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "comment_url": { "type": "string", "pattern": "^https://github\\.com/penguin425/denoize/issues/221#issuecomment-[1-9][0-9]*$" },
        "author": { "const": "UlisesMilani" },
        "created_at": { "type": "string", "format": "date-time" },
        "updated_at": { "type": "string", "format": "date-time" },
        "comment_body_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "schema_version", "source_commit", "artifact_sha256", "environment", "runs", "accessibility", "quality_observation", "consent_to_publish"],
      "properties": {
        "schema": { "const": "denoize-dpdfnet-reporter-submission-v2" },
        "schema_version": { "const": 2 },
        "source_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "artifact_sha256": { "$ref": "#/$defs/sha256" },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["windows_version", "cpu_model", "audio_device", "audio_driver", "reaper_version", "nvda_version", "osara_version"],
          "properties": {
            "windows_version": { "$ref": "#/$defs/bounded" },
            "cpu_model": { "$ref": "#/$defs/bounded" },
            "audio_device": { "$ref": "#/$defs/bounded" },
            "audio_driver": { "$ref": "#/$defs/bounded" },
            "reaper_version": { "$ref": "#/$defs/bounded" },
            "nvda_version": { "$ref": "#/$defs/bounded" },
            "osara_version": { "$ref": "#/$defs/bounded" }
          }
        },
        "runs": {
          "type": "array",
          "minItems": 3,
          "maxItems": 16,
          "items": { "$ref": "#/$defs/runSubmission" }
        },
        "accessibility": {
          "type": "object",
          "additionalProperties": false,
          "required": ["nvda_active", "osara_active", "parameters_announced", "values_announced", "all_adjustable", "focus_stable", "host_or_plugin_crashes"],
          "properties": {
            "nvda_active": { "type": "boolean" },
            "osara_active": { "type": "boolean" },
            "parameters_announced": {
              "type": "array",
              "minItems": 0,
              "maxItems": 16,
              "items": { "$ref": "#/$defs/bounded" }
            },
            "values_announced": { "type": "boolean" },
            "all_adjustable": { "type": "boolean" },
            "focus_stable": { "type": "boolean" },
            "host_or_plugin_crashes": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
          }
        },
        "quality_observation": { "enum": ["dpdfnet-better", "equivalent", "gtcrn-better"] },
        "consent_to_publish": { "const": true }
      }
    },
    "runSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_buffer_frames", "host_evidence_url", "host_evidence_sha256", "audible_xruns", "continuous_audio"],
      "properties": {
        "requested_buffer_frames": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "host_evidence_url": { "type": "string", "pattern": "^https://github\\.com/user-attachments/files/[1-9][0-9]*/[A-Za-z0-9._-]{1,160}\\.json$" },
        "host_evidence_sha256": { "$ref": "#/$defs/sha256" },
        "audible_xruns": { "$ref": "#/$defs/audibleXruns" },
        "continuous_audio": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "audible_xruns": { "type": "null" } } },
          "then": { "properties": { "continuous_audio": { "const": false } } }
        }
      ]
    },
    "normalizedRun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_buffer_frames", "sample_rate_hz", "duration_seconds", "effective_buffer_frames", "worker_started", "finished_gracefully", "overload_blocks", "late_blocks", "invalid_blocks", "worker_errors", "audible_xruns", "continuous_audio", "host_evidence"],
      "properties": {
        "requested_buffer_frames": { "type": "integer", "minimum": 16, "maximum": 8192 },
        "sample_rate_hz": { "type": "integer", "minimum": 8000, "maximum": 192000 },
        "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000000 },
        "effective_buffer_frames": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/effectiveBuffer" }
          ]
        },
        "worker_started": { "type": "boolean" },
        "finished_gracefully": { "type": "boolean" },
        "overload_blocks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "late_blocks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "invalid_blocks": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "worker_errors": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "audible_xruns": { "$ref": "#/$defs/audibleXruns" },
        "continuous_audio": { "type": "boolean" },
        "host_evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "name", "size_bytes", "sha256", "schema"],
          "properties": {
            "url": { "type": "string", "pattern": "^https://github\\.com/user-attachments/files/[1-9][0-9]*/[A-Za-z0-9._-]{1,160}\\.json$" },
            "name": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,160}\\.json$" },
            "size_bytes": { "type": "integer", "minimum": 1, "maximum": 2097152 },
            "sha256": { "$ref": "#/$defs/sha256" },
            "schema": { "enum": ["denoize-dpdfnet-clap-host-run-v1", "denoize-dpdfnet-clap-host-run-v2"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "audible_xruns": { "type": "null" } } },
          "then": { "properties": { "continuous_audio": { "const": false } } }
        }
      ]
    },
    "effectiveBuffer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activation_minimum", "activation_maximum", "callback_calls", "observed_minimum", "observed_maximum"],
      "properties": {
        "activation_minimum": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "activation_maximum": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "callback_calls": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        "observed_minimum": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "observed_maximum": { "type": "integer", "minimum": 1, "maximum": 1048576 }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "observed", "operator", "limit", "passed"],
      "properties": {
        "id": {
          "enum": [
            "reaper-version", "run-duration-rate", "requested-buffer-coverage",
            "effective-buffer-observed", "realtime-worker", "audible-continuity",
            "nvda-osara", "no-host-plugin-crashes"
          ]
        },
        "observed": { "type": "integer", "minimum": 0, "maximum": 1 },
        "operator": { "const": "greater-or-equal" },
        "limit": { "const": 1 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
