{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/penguin425/denoize/raw/main/schemas/denoize-cli-output-v1.schema.json",
  "title": "denoize CLI JSON and NDJSON output v1",
  "oneOf": [
    { "$ref": "#/$defs/fileResult" },
    { "$ref": "#/$defs/streamResult" },
    { "$ref": "#/$defs/batchProgress" },
    { "$ref": "#/$defs/batchSummary" },
    { "$ref": "#/$defs/liveStatus" },
    { "$ref": "#/$defs/pluginInfo" },
    { "$ref": "#/$defs/pluginLatency" },
    { "$ref": "#/$defs/pluginNeuralInfo" },
    { "$ref": "#/$defs/pluginNeuralLatency" },
    { "$ref": "#/$defs/pluginNeuralSessionValidation" },
    { "$ref": "#/$defs/pluginPresetValidation" },
    { "$ref": "#/$defs/pluginSessionValidation" }
  ],
  "$defs": {
    "recipe": {
      "type": "object",
      "required": ["domain", "version", "output_abi_version", "digest"],
      "properties": {
        "domain": { "const": "denoize-batch-recipe-v3" },
        "version": { "const": 3 },
        "output_abi_version": { "type": "integer", "minimum": 1 },
        "digest": {
          "oneOf": [
            { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            { "type": "null" }
          ]
        }
      }
    },
    "accelerator": {
      "type": "object",
      "required": ["requested", "effective", "fallback"],
      "properties": {
        "requested": { "enum": ["cpu", "auto", "gpu", "metal", "cuda"] },
        "effective": { "enum": ["cpu", "metal", "cuda"] },
        "fallback": {
          "oneOf": [
            {
              "enum": [
                "deterministic-mode",
                "backend-cpu-only",
                "no-available-gpu"
              ]
            },
            { "type": "null" }
          ]
        }
      },
      "additionalProperties": false
    },
    "common": {
      "type": "object",
      "required": ["schema", "schema_version", "event", "recipe"],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "type": "string" },
        "recipe": { "$ref": "#/$defs/recipe" }
      }
    },
    "fileResult": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [
            "event",
            "mode",
            "input",
            "output",
            "backend",
            "channels",
            "frames",
            "sample_rate",
            "elapsed_ms"
          ],
          "properties": {
            "event": { "const": "result" },
            "mode": { "const": "file" },
            "input": { "type": "string" },
            "output": { "type": "string" },
            "backend": { "type": "string" },
            "accelerator": { "$ref": "#/$defs/accelerator" },
            "channels": { "type": "integer", "minimum": 1 },
            "frames": { "type": "integer", "minimum": 0 },
            "sample_rate": { "type": "integer", "minimum": 1 },
            "elapsed_ms": { "type": "number", "minimum": 0 }
          }
        }
      ]
    },
    "streamResult": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [
            "event",
            "mode",
            "input",
            "output",
            "backend",
            "channels",
            "frames",
            "sample_rate",
            "stream"
          ],
          "properties": {
            "event": { "const": "result" },
            "mode": { "const": "stream" },
            "input": { "type": "string" },
            "output": { "type": "string" },
            "backend": { "type": "string" },
            "accelerator": { "$ref": "#/$defs/accelerator" },
            "channels": { "type": "integer", "minimum": 1 },
            "frames": { "type": "integer", "minimum": 0 },
            "sample_rate": { "type": "integer", "minimum": 1 },
            "stream": { "const": true }
          }
        }
      ]
    },
    "batchProgress": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [
            "event",
            "status",
            "completed",
            "total",
            "elapsed_seconds",
            "eta_seconds",
            "input"
          ],
          "properties": {
            "event": { "const": "progress" },
            "status": { "enum": ["completed", "skipped", "failed", "cancelled"] },
            "completed": { "type": "integer", "minimum": 0 },
            "total": { "type": "integer", "minimum": 1 },
            "elapsed_seconds": { "type": "number", "minimum": 0 },
            "eta_seconds": { "type": "number", "minimum": 0 },
            "input": { "type": "string" }
          }
        }
      ]
    },
    "batchSummary": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": [
            "event",
            "total",
            "succeeded",
            "skipped",
            "failed",
            "cancelled_count",
            "cancelled",
            "output"
          ],
          "properties": {
            "event": { "const": "summary" },
            "total": { "type": "integer", "minimum": 0 },
            "succeeded": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "cancelled_count": { "type": "integer", "minimum": 0 },
            "cancelled": { "type": "boolean" },
            "output": { "type": "string" }
          }
        }
      ]
    },
    "pluginInfo": {
      "type": "object",
      "required": [
        "schema", "schema_version", "event", "plugin_id", "name", "version",
        "format", "port_configurations", "sample_formats", "factory_presets",
        "latency_policy", "latency_millis", "realtime_contract"
      ],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "plugin-info" },
        "plugin_id": { "const": "org.penguin425.denoize" },
        "name": { "const": "denoize" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "format": { "const": "CLAP" },
        "port_configurations": { "const": ["mono", "stereo"] },
        "sample_formats": { "const": ["f32", "f64"] },
        "factory_presets": { "const": ["speech", "gentle", "music"] },
        "latency_policy": { "const": "fixed-10ms-v1" },
        "latency_millis": { "const": 10 },
        "realtime_contract": {
          "type": "object",
          "required": ["allocations", "locks", "file_io", "system_calls"],
          "properties": {
            "allocations": { "const": 0 },
            "locks": { "const": 0 },
            "file_io": { "const": false },
            "system_calls": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pluginLatency": {
      "type": "object",
      "required": [
        "schema", "schema_version", "event", "plugin_id", "latency_policy",
        "sample_rate", "latency_frames", "latency_millis",
        "measured_latency_frames", "matches_reported", "measurement"
      ],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "plugin-latency" },
        "plugin_id": { "const": "org.penguin425.denoize" },
        "latency_policy": { "const": "fixed-10ms-v1" },
        "sample_rate": { "type": "number", "exclusiveMinimum": 0, "maximum": 1234568 },
        "latency_frames": { "type": "integer", "minimum": 1 },
        "latency_millis": { "type": "number", "exclusiveMinimum": 0 },
        "measured_latency_frames": { "type": "integer", "minimum": 1 },
        "matches_reported": { "const": true },
        "measurement": { "const": "f64-bypass-impulse-v1" }
      },
      "additionalProperties": false
    },
    "pluginNeuralInfo": {
      "type": "object",
      "required": [
        "schema", "schema_version", "event", "plugin_id", "name", "version",
        "format", "backend", "model_id", "model_sha256", "model_installed",
        "port_configurations", "reference_port", "sample_formats", "sample_rate",
        "chunk_frames", "latency_policy", "latency_frames", "latency_millis",
        "queue_blocks", "overload_fallbacks", "realtime_contract"
      ],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "plugin-neural-info" },
        "plugin_id": { "const": "org.penguin425.denoize.neural" },
        "name": { "const": "denoize Neural" },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "format": { "const": "CLAP" },
        "backend": { "const": "gtcrn" },
        "model_id": { "const": "gtcrn-dns3" },
        "model_sha256": {
          "const": "b4718df6228e7bdf1a8a435cf98f838636eb2fd331acabf86ba87c5192ebcb87"
        },
        "model_installed": { "type": "boolean" },
        "port_configurations": { "const": ["mono", "stereo"] },
        "reference_port": { "const": "reserved-independent-input" },
        "sample_formats": { "const": ["f32", "f64"] },
        "sample_rate": { "type": "number", "minimum": 1, "maximum": 1234568 },
        "chunk_frames": { "type": "integer", "minimum": 1 },
        "latency_policy": { "const": "fixed-24x10ms-worker-v1" },
        "latency_frames": { "type": "integer", "minimum": 1 },
        "latency_millis": { "type": "number", "exclusiveMinimum": 0 },
        "queue_blocks": { "const": 24 },
        "overload_fallbacks": {
          "const": ["delayed-dry", "last-safe-gain", "silence"]
        },
        "realtime_contract": {
          "type": "object",
          "required": [
            "allocations", "locks", "file_io", "network_io", "logging",
            "worker_waits", "inference_on_callback"
          ],
          "properties": {
            "allocations": { "const": 0 },
            "locks": { "const": 0 },
            "file_io": { "const": false },
            "network_io": { "const": false },
            "logging": { "const": false },
            "worker_waits": { "const": false },
            "inference_on_callback": { "const": false }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "pluginNeuralLatency": {
      "type": "object",
      "required": [
        "schema", "schema_version", "event", "plugin_id", "latency_policy",
        "sample_rate", "chunk_frames", "latency_frames", "latency_millis",
        "measured_latency_frames", "matches_reported", "measurement"
      ],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "plugin-neural-latency" },
        "plugin_id": { "const": "org.penguin425.denoize.neural" },
        "latency_policy": { "const": "fixed-24x10ms-worker-v1" },
        "sample_rate": { "type": "number", "minimum": 1, "maximum": 1234568 },
        "chunk_frames": { "type": "integer", "minimum": 1 },
        "latency_frames": { "type": "integer", "minimum": 1 },
        "latency_millis": { "type": "number", "exclusiveMinimum": 0 },
        "measured_latency_frames": { "type": "integer", "minimum": 1 },
        "matches_reported": { "const": true },
        "measurement": { "const": "f64-delayed-dry-impulse-v1" }
      },
      "additionalProperties": false
    },
    "pluginNeuralSessionValidation": {
      "type": "object",
      "required": [
        "schema", "schema_version", "event", "valid", "path", "plugin_id",
        "model_id", "model_sha256", "port_configuration", "latency_policy"
      ],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "plugin-neural-session-validation" },
        "valid": { "const": true },
        "path": { "type": "string", "minLength": 1 },
        "plugin_id": { "const": "org.penguin425.denoize.neural" },
        "model_id": { "const": "gtcrn-dns3" },
        "model_sha256": {
          "const": "b4718df6228e7bdf1a8a435cf98f838636eb2fd331acabf86ba87c5192ebcb87"
        },
        "port_configuration": { "enum": ["mono", "stereo"] },
        "latency_policy": { "const": "fixed-24x10ms-worker-v1" }
      },
      "additionalProperties": false
    },
    "pluginPresetValidation": {
      "type": "object",
      "required": ["schema", "schema_version", "event", "valid", "path", "plugin_id", "name"],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "plugin-preset-validation" },
        "valid": { "const": true },
        "path": { "type": "string", "minLength": 1 },
        "plugin_id": { "const": "org.penguin425.denoize" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 }
      },
      "additionalProperties": false
    },
    "pluginSessionValidation": {
      "type": "object",
      "required": [
        "schema", "schema_version", "event", "valid", "path", "plugin_id",
        "port_configuration", "latency_policy"
      ],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "plugin-session-validation" },
        "valid": { "const": true },
        "path": { "type": "string", "minLength": 1 },
        "plugin_id": { "const": "org.penguin425.denoize" },
        "port_configuration": { "enum": ["mono", "stereo"] },
        "latency_policy": { "const": "fixed-10ms-v1" }
      },
      "additionalProperties": false
    },
    "liveStatus": {
      "type": "object",
      "required": [
        "schema",
        "schema_version",
        "event",
        "mode",
        "state",
        "input_sample_rate",
        "output_sample_rate",
        "input_channels",
        "output_channels",
        "chunk_frames",
        "input_level",
        "output_level",
        "processed_chunks",
        "dropped_chunks",
        "underrun_frames",
        "overflow_frames",
        "queued_frames",
        "target_queue_frames",
        "queue_latency_ms",
        "processing_latency_ms",
        "input_device_latency_ms",
        "output_device_latency_ms",
        "estimated_total_latency_ms",
        "drift_correction_ppm",
        "reconnect_attempts",
        "device_generation",
        "accelerator"
      ],
      "properties": {
        "schema": { "const": "denoize-cli-output-v1" },
        "schema_version": { "const": 1 },
        "event": { "const": "status" },
        "mode": { "const": "live" },
        "state": {
          "enum": ["connecting", "priming", "running", "recovering", "unknown"]
        },
        "input_sample_rate": { "type": "integer", "minimum": 0 },
        "output_sample_rate": { "type": "integer", "minimum": 0 },
        "input_channels": { "type": "integer", "minimum": 0 },
        "output_channels": { "type": "integer", "minimum": 0 },
        "chunk_frames": { "type": "integer", "minimum": 0 },
        "input_level": { "type": "number", "minimum": 0 },
        "output_level": { "type": "number", "minimum": 0 },
        "processed_chunks": { "type": "integer", "minimum": 0 },
        "dropped_chunks": { "type": "integer", "minimum": 0 },
        "underrun_frames": { "type": "integer", "minimum": 0 },
        "overflow_frames": { "type": "integer", "minimum": 0 },
        "queued_frames": { "type": "integer", "minimum": 0 },
        "target_queue_frames": { "type": "integer", "minimum": 0 },
        "queue_latency_ms": { "type": "number", "minimum": 0 },
        "processing_latency_ms": { "type": "number", "minimum": 0 },
        "input_device_latency_ms": { "type": "number", "minimum": 0 },
        "output_device_latency_ms": { "type": "number", "minimum": 0 },
        "estimated_total_latency_ms": { "type": "number", "minimum": 0 },
        "drift_correction_ppm": { "type": "number", "minimum": -10000, "maximum": 10000 },
        "reconnect_attempts": { "type": "integer", "minimum": 0 },
        "device_generation": { "type": "integer", "minimum": 0 },
        "accelerator": { "$ref": "#/$defs/accelerator" }
      }
    }
  }
}
